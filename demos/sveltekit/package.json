{
    "name": "scichart-svelte-sveltekit-demo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "SciChart.js + scichart-svelte demo on SvelteKit 3 with server-side rendering",
    "scripts": {
        "copyWasm": "node scripts/copy-wasm.mjs static",
        "dev": "npm run copyWasm && vite dev",
        "build": "npm run copyWasm && npm run check && vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
    },
    "dependencies": {
        "scichart": "6.0.13",
        "scichart-svelte": "file:../..",
        "svelte": "5.57.3"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "6.0.2",
        "@sveltejs/kit": "3.2.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "svelte-check": "4.7.8",
        "typescript": "6.0.3",
        "vite": "8.3.8"
    }
}
